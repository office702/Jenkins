def notifyProduction(String status) {
    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS', catchInterruptions: false,
               message: 'Could not queue the WeCom production notification.') {
        build job: '/audioTranslation-wecom-notify', wait: false, quietPeriod: 0, parameters: [
            string(name: 'EVENT', value: 'production_' + status),
            string(name: 'REPORT_BUILD', value: env.BUILD_NUMBER),
            string(name: 'REPORT_URL', value: env.BUILD_URL ?: ''),
            string(name: 'REQUESTED_BY', value: env.RELEASE_REQUESTED_BY ?: 'automation'),
            string(name: 'PACKAGE_BUILD', value: env.PACKAGE_BUILD_NUMBER ?: '')
        ]
    }
}

pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '25'))
        timeout(time: 95, unit: 'MINUTES')
    }

    stages {
        stage('Build and archive main') {
            steps {
                script {
                    def requester = currentBuild.getBuildCauses().find { it.userId }
                    env.RELEASE_REQUESTED_BY = requester?.userId ?: 'automation'
                    def artifacts = build job: '/packaging/audioTranslation', wait: true, propagate: true
                    env.PACKAGE_BUILD_NUMBER = artifacts.number.toString()
                    currentBuild.description = 'Production release from package #' + env.PACKAGE_BUILD_NUMBER
                }
            }
        }
        stage('Deploy verified image to production') {
            agent { label 'audio-mac-docker' }
            steps {
                deleteDir()
                copyArtifacts projectName: '/packaging/audioTranslation',
                    selector: specific(env.PACKAGE_BUILD_NUMBER),
                    filter: 'artifacts/docker/*.tar.gz,artifacts/docker/*.tar.gz.sha256,artifacts/docker/build.json',
                    fingerprintArtifacts: false
                withCredentials([sshUserPrivateKey(credentialsId: 'audioTranslation-production-release',
                    keyFileVariable: 'RELEASE_KEY', usernameVariable: 'RELEASE_USER')]) {
                    sh '''#!/bin/bash
set +x
set -euo pipefail
bundle="$WORKSPACE/artifacts/docker"
known_hosts="$HOME/Library/Application Support/Jenkins/production-stage/known_hosts"
host_key_setting='UserKnownHostsFile="'"$known_hosts"'"'
metadata=$(/usr/bin/python3 - "$bundle" "$PACKAGE_BUILD_NUMBER" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

root, number = Path(sys.argv[1]), sys.argv[2]
manifest = json.loads((root / "build.json").read_text(encoding="utf-8"))
commit, digest, image_id = (manifest[key] for key in ("git_commit", "sha256", "image_id"))
assert re.fullmatch(r"[0-9a-f]{40}", commit) and re.fullmatch(r"[1-9][0-9]*", number)
assert re.fullmatch(r"[0-9a-f]{64}", digest) and re.fullmatch(r"sha256:[0-9a-f]{64}", image_id)
tag = f"amd64-{commit[:12]}-b{number}"
assert manifest["platform"] == "linux/amd64" and manifest["image"] == "audio-translation-prod:" + tag
name = f"audio-translation-prod-{tag}.tar.gz"
assert manifest["artifact"] == name
archive = root / name
assert archive.stat().st_size == manifest["bytes"]
assert (root / (name + ".sha256")).read_text().split() == [digest, name]
hasher = hashlib.sha256()
with archive.open("rb") as stream:
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        hasher.update(chunk)
assert hasher.hexdigest() == digest
print(tag, digest, commit, image_id, name)
PY
)
read -r tag digest commit image_id archive <<< "$metadata"
/usr/bin/ssh -F /dev/null -T -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
    -o "$host_key_setting" -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=12 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    -i "$RELEASE_KEY" "$RELEASE_USER@43.136.77.153" \
    "release-verified $tag $digest $commit $image_id" < "$bundle/$archive" > release-server.json
/usr/bin/python3 - "$tag" "$digest" "$commit" <<'PY'
import json
import os
import sys
from pathlib import Path

tag, digest, commit = sys.argv[1:]
result = json.loads(Path("release-server.json").read_text())
assert result["live_tag"] == tag and result["sha256"] == digest and result["commit"] == commit
assert result["capture_idle"] and result["preflight"] == "passed" and result["public_https"] == "passed"
result["pipeline_url"] = os.environ["BUILD_URL"]
result["package_build"] = int(os.environ["PACKAGE_BUILD_NUMBER"])
result["triggered_by"] = os.environ["RELEASE_REQUESTED_BY"]
Path("production-release.json").write_text(json.dumps(result, indent=2) + "\\n")
print("Production release passed:", tag)
PY
'''
                }
                archiveArtifacts artifacts: 'production-release.json', fingerprint: true
            }
            post {
                cleanup {
                    deleteDir()
                }
            }
        }
    }
    post {
        cleanup {
            script {
                notifyProduction(currentBuild.currentResult)
            }
        }
    }
}
